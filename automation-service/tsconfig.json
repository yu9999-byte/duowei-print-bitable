{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../src/automation/**/*.ts"],
  "exclude": ["../src/automation/feishu-action-adapters.ts", "../src/automation/feishu-automation-block.ts"]
}
