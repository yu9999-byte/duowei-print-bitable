{
  "name": "duowei-print-bitable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "dev": "cross-env NODE_ENV=development webpack-dev-server --mode development --config record-view/webpack.config.cjs",
    "build": "vue-tsc -b && cross-env NODE_ENV=production webpack --mode production --config record-view/webpack.config.cjs",
    "upload": "npm run build && cd record-view && opdev upload ./dist -t block -v patch -d \"多维打印记录视图插件\""
  },
  "dependencies": {
    "@lark-base-open/js-sdk": "1.0.2",
    "@lark-opdev/block-bitable-api": "0.4.1-alpha.11",
    "vue": "3.5.13",
    "vue-print-designer": "1.7.39"
  },
  "devDependencies": {
    "@lark-opdev/block-bitable-webpack-utils": "0.1.7",
    "@lark-opdev/cli": "3.4.4",
    "@vue/tsconfig": "0.7.0",
    "cross-env": "7.0.3",
    "css-loader": "7.1.5",
    "html-webpack-plugin": "5.6.8",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.8.3",
    "vue-loader": "17.4.2",
    "vue-tsc": "2.2.8",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.6"
  },
  "overrides": {
    "lodash.template": "4.5.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
