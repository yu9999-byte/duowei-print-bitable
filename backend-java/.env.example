# Reference only: Spring Boot does not automatically load this file.
# Export variables in your shell or configure them in the service manager.

# Required database configuration. JDBC URL, not the original Node postgres URL.
DUOWEI_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/duowei
DUOWEI_DATABASE_USERNAME=
DUOWEI_DATABASE_PASSWORD=

# Required service and Feishu credentials. Supply real values outside Git.
DUOWEI_SERVICE_AUTHORIZATION=
DUOWEI_FEISHU_APP_ID=
DUOWEI_FEISHU_APP_SECRET=
DUOWEI_EVENT_VERIFICATION_TOKEN=

# Required signing secrets: at least 32 bytes each, encoded as hex.
# Preserve existing protocol keys when migrating an existing installation.
DUOWEI_REGISTRY_WRITE_SIGNING_SECRET_HEX=
DUOWEI_REGISTRY_READ_SIGNING_SECRET_HEX=
DUOWEI_RENDERER_SIGNING_SECRET_HEX=
DUOWEI_BACKGROUND_JOB_SIGNING_SECRET_HEX=

# Required HTTPS URLs and comma-separated HTTPS origins.
DUOWEI_PUBLIC_AUTOMATION_BASE_URL=https://service.example/openapi/duowei-print
DUOWEI_OAUTH_REDIRECT_URI=https://service.example/api/automation/oauth/callback
DUOWEI_RENDER_PAGE_URL=https://service.example/openapi/duowei-print/renderer
DUOWEI_ALLOWED_ORIGINS=https://plugin.example

# Optional runtime values; defaults shown.
PORT=8080
DUOWEI_BACKGROUND_WORKER_INTERVAL_MS=2000
# DUOWEI_CHROMIUM_EXECUTABLE_PATH=C:/path/to/chrome.exe
# ChromeDriver must be on PATH or configured with -Dwebdriver.chrome.driver=...

# Local debugging only. Permits HTTP for localhost/127.0.0.1 service URLs.
# DUOWEI_ALLOW_INSECURE_LOCAL_RENDERER=true

# Optional integration test variables; use a dedicated test database.
# DUOWEI_TEST_POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/duowei_test
# DUOWEI_TEST_POSTGRES_USERNAME=
# DUOWEI_TEST_POSTGRES_PASSWORD=
